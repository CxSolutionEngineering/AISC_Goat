# ------------------------------------------------------------------
# NOTE: .mcp.json is intentionally committed. It is a discovery
# target for the AI supply chain scan and contains no secrets
# (tokens are ${ENV_VAR} placeholders). Do not add it here.
# ------------------------------------------------------------------

# Secrets and local environment
.env
.env.*
!.env.example
*.secrets.yaml
mcp_agent.secrets.yaml
.streamlit/secrets.toml

# Claude Code per-user settings (project .mcp.json and skills stay tracked)
.claude/settings.local.json
CLAUDE.local.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Node / TypeScript
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
.npm/

# Downloaded model weights and caches (the scanner pulls these from
# the Hub; they should never be committed to this repo)
.cache/
hf_cache/
models_cache/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf
*.onnx
*.h5
*.pkl
*.pickle

# Local vector stores and app data
qdrant_storage/
*.lancedb/
*.sqlite
*.db
tmp/

# Scan output
scan-results/
*.sarif

# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
